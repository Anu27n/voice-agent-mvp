# Copy to .env and fill in the keys. Every setting has a default; see README.md.

# --- Providers -------------------------------------------------------------
# "auto" uses the real provider whose key is set below, and the offline mock
# otherwise. Built-in names: stt = deepgram | mock, llm = anthropic | mock,
# tts = deepgram | elevenlabs | mock. A custom adapter: "package.module:ClassName".
STT_PROVIDER=auto
LLM_PROVIDER=auto
TTS_PROVIDER=auto

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Only needed for TTS_PROVIDER=elevenlabs (or auto without a Deepgram key)
ELEVENLABS_API_KEY=

# --- LLM -------------------------------------------------------------------
LLM_MODEL=claude-opus-5-5
# low keeps time-to-first-token short; raise for harder conversations
LLM_EFFORT=low
# "default" re-runs a request a safety classifier declines on a fallback model; "off" disables
LLM_FALLBACKS=default
# SYSTEM_PROMPT=You are ...
# SYSTEM_PROMPT_FILE=prompts/agent.txt
# PROMPT_VERSION=v1

# --- Tools -----------------------------------------------------------------
ENABLE_WEATHER=true
ALLOW_AGENT_HANGUP=true
# DEFAULT_TIMEZONE=Asia/Kolkata

# --- Voice activity detection ------------------------------------------------
VAD_SILENCE_MS=600
VAD_START_MS=100
VAD_MIN_UTTERANCE_MS=250
VAD_THRESHOLD_DB=-45

# --- Call limits and public deployments ------------------------------------
SILENCE_TIMEOUT_S=120
MAX_CALL_DURATION_S=600
MAX_ACTIVE_CALLS=10
# ACCESS_CODE=choose-a-passphrase

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DB_PATH=data/voice_agent.db
LOG_LEVEL=INFO
LOG_FORMAT=text
