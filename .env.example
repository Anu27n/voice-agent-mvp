# Copy to .env and fill in the keys. Every setting has a default; see README.md.

# --- Providers -------------------------------------------------------------
# Built-in names: stt = deepgram | mock, llm = anthropic | mock,
# tts = deepgram | elevenlabs | mock. A custom adapter: "package.module:ClassName".
STT_PROVIDER=deepgram
LLM_PROVIDER=anthropic
TTS_PROVIDER=deepgram

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Only needed for TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# --- LLM -------------------------------------------------------------------
LLM_MODEL=claude-opus-5-5
# low keeps time-to-first-token short; raise for harder conversations
LLM_EFFORT=low
# "default" re-runs a request a safety classifier declines on a fallback model; "off" disables
LLM_FALLBACKS=default
# SYSTEM_PROMPT=You are ...
# SYSTEM_PROMPT_FILE=prompts/agent.txt
# PROMPT_VERSION=v1

# --- Voice activity detection ------------------------------------------------
VAD_SILENCE_MS=600
VAD_START_MS=100
VAD_MIN_UTTERANCE_MS=250
VAD_THRESHOLD_DB=-45

# --- Call limits -------------------------------------------------------------
SILENCE_TIMEOUT_S=120
MAX_CALL_DURATION_S=600

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DB_PATH=data/voice_agent.db
LOG_LEVEL=INFO
